# Replace both values before starting the admin portal.
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# Bot configuration. 26.3 is the requested target; current Prismarine packages
# require a currently-supported version such as 26.1 until their 26.3 data lands.
MC_VERSION=26.3
MAX_BOTS=12
BOT_AUTOSTART=true

# Keep the JSON bot config and Microsoft account sessions outside Git.
BOT_CONFIG_PATH=../../data/bots.json
MICROSOFT_PROFILES_PATH=../../data/profiles

# Viewer servers use one private port per online bot. Do not expose this range publicly.
VIEWER_PORT_START=3200
PORT=5000
NODE_ENV=development
